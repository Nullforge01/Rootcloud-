# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase dashboard: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key is SECRET - only used on the server (never sent to the browser).
# Needed so the upload API can write files even if the bucket is private.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
